# VisionGuard AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./visionguard.db
# Docker Postgres:
# DATABASE_URL=postgresql://visionguard:visionguard@localhost:5432/visionguard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# false = REAL DATA (default) — OpenWeather / NASA POWER / Copernicus STAC / optional IMD
# true  = DEMO DATA only — mock weather + synthetic satellite (explicit fallback mode)
# Real Data Mode never silently substitutes demo numbers/images when a live provider fails.
USE_MOCK_PROVIDERS=false

# --- OpenWeather (current + forecast) ---
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_QUERY=Bengaluru,IN

# --- NASA POWER (historical daily meteorology, no key required) ---
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_ENABLED=true

# --- IMD official API (optional; requires account / JWT from https://api.imd.gov.in) ---
# Do not invent IMD products when this is empty — the app reports IMD unavailable.
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_STATION_ID=43314

# --- Copernicus Data Space Ecosystem (Sentinel STAC) ---
# Catalogue search works without OAuth for many CDSE STAC queries.
# OAuth improves access to protected assets; create a client in the CDSE dashboard.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_MAX_CLOUD=40
COPERNICUS_LOOKBACK_DAYS=60
# Analysis window floor (user-selectable end date). Not a live EO stream.
SATELLITE_MIN_START_DATE=2026-05-01

# Primary live AOI (Karnataka / Bengaluru, India)
AOI_NAME=Karnataka / Bengaluru (India)
DEMO_LATITUDE=12.9716
DEMO_LONGITUDE=77.5946

# GIS reference layers via OpenStreetMap Overpass (STATIC_EXTERNAL — not live incidents)
GIS_OVERPASS_ENABLED=true
GIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
GIS_CACHE_TTL_SEC=3600
GIS_BBOX_PAD_DEG=0.06

LOG_LEVEL=INFO
VISION_STORAGE_DIR=./storage/vision
MAX_UPLOAD_MB=8
# Local YOLO weights only — never auto-download. Leave empty to use DemoVisionModel.
YOLO_WEIGHTS_PATH=
ENABLE_REAL_EMAIL=false
ENABLE_REAL_SMS=false
ENABLE_REAL_PUSH=false
SMTP_HOST=
SMS_API_KEY=
PUSH_API_KEY=
