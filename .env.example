# Copy to backend/.env
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Required for current conditions + 5-day forecast: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Optional NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Public South Asia feeds are used without it.
FIRMS_MAP_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///./visionguard.db
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSRM_URL=https://router.project-osrm.org
# SATELLITE_MAX_PIXELS=768
MAX_UPLOAD_MB=8
YOLO_MODEL=yolov8n.pt
REFRESH_INTERVAL_MIN=30
