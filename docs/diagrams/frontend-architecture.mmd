    FL["/flood-detection FloodPage"]
    DM["/damage-assessment DamagePage"]
    RS["/rescue-planning RescuePage"]
    AL["/alerts AlertsPage"]
    AN["/analytics AnalyticsPage"]
    DD["/disasters/:id DisasterDetailPage"]
    ST["/settings SettingsPage"]
