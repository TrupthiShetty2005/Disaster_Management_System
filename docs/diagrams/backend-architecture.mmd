%% Backend layers from backend/app

flowchart TB
  FAST[FastAPI app.main]
  MW[CORSMiddleware]
  ERR[register_exception_handlers]
  LIFE[lifespan: init_db + seed_if_empty]
  FAST --> MW --> ERR --> LIFE
  LIFE --> RTR[api/v1/router.py]

  RTR --> SCH[schemas/common.py Pydantic]

  subgraph SERVICES["Services that exist"]
    OPS[ops.py Disaster Risk Weather Resource Evacuation]
    WI[weather_intel.py]
    SAT[satellite/service.py]
    VIS[vision/pipeline.py]
    FL[flood/service.py]
    DMG[damage/service.py]
    RES[rescue/service.py]
    AL[alerts/service.py EarlyWarningService]
    AN[analytics/service.py]
    INC[incident/service.py]
    REP[reports/service.py]
  end

  RTR --> OPS & WI & SAT & VIS & FL & DMG & RES & AL & AN & INC & REP

  OPS --> REPO[repositories/ops.py]
  REPO --> ORM[models/entities.py]
  SAT --> ORM
  VIS --> ORM
  FL --> ORM
  DMG --> ORM
  RES --> ORM
  AL --> ORM
  AN --> ORM
  INC --> ORM
  ORM --> DB[(engine session.py<br/>SQLite or DATABASE_URL)]
