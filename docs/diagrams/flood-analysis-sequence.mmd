sequenceDiagram
  actor User
  participant FE as FloodPage
  participant API as FastAPI
  participant FS as FloodDetectionService
  participant M as DemoFloodModel
  participant GEO as flood/geo.py
  participant DB as flood_analyses

  User->>FE: Click Run flood analysis
  FE->>API: POST /flood/analyze {scene_kind, population}
  API->>FS: analyze()
  FS->>FS: generate_demo_raster
  FS->>M: segment(rgb)
  M->>M: OpenCV detect_water
  FS->>GEO: extract_polygons heatmap flooded_area_km2
  FS->>DB: insert FloodAnalysis
  DB-->>API: row
  API-->>FE: FloodEventOut GeoJSON
  FE->>FE: SatelliteOverlayMap
  FE-->>User: Extent overlay and KPIs
