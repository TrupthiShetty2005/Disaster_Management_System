%% VisionGuard AI — observed system architecture
%% Solid boxes = implemented. Mock/demo vs optional live adapters labeled in nodes.

flowchart TB
  USER[User / browser]
  FE[React SPA<br/>frontend/ Vite]
  AC[apiClient.ts<br/>fetch JSON / FormData]
  API[FastAPI<br/>backend/app/main.py]
  RTR[APIRouter /api/v1<br/>router.py]
  SVC[Service layer]
  DB[(SQLAlchemy ORM<br/>SQLite default<br/>Postgres URL optional)]

  USER --> FE
  FE --> AC
  AC --> API
  API --> RTR
  RTR --> SVC
  SVC --> DB
  DB --> SVC
  SVC --> RTR
  RTR --> AC
  AC --> FE

  subgraph PROVIDERS["External / adapter layer"]
    WP_M[MockWeatherProvider<br/>MOCK default]
    WP_O[OpenWeatherProvider<br/>OPTIONAL live HTTP]
    SAT_M[MockSatelliteProvider<br/>MOCK always selected]
    SAT_S[SentinelLandsatProvider<br/>class exists still mock]
    VIS_D[DemoVisionModel<br/>MOCK detections]
    VIS_Y[YOLOVisionModel<br/>OPTIONAL local weights]
    GIS[Frontend GIS<br/>gisMock.ts GeoJSON<br/>Leaflet layers]
    PG[Postgres/PostGIS image<br/>Docker only — app uses JSON GeoJSON]
    NTF[Notification adapters<br/>dashboard mock; SMS/email/push unwired]
  end

  SVC --> WP_M
  SVC -.-> WP_O
  SVC --> SAT_M
  SAT_S -.-> SAT_M
  SVC --> VIS_D
  SVC -.-> VIS_Y
  FE --> GIS
  SVC -.-> PG
  SVC --> NTF

  classDef mock fill:#3f3f46,stroke:#f59e0b,color:#fde68a
  classDef optional fill:#1e3a5f,stroke:#38bdf8,color:#e0f2fe
  classDef core fill:#14532d,stroke:#86efac,color:#dcfce7
  class WP_M,SAT_M,VIS_D,NTF,GIS mock
  class WP_O,VIS_Y,SAT_S,PG optional
  class API,RTR,SVC,DB,FE,AC core
