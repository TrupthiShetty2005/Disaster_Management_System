# Copy to .env.live and fill values. NEVER commit .env.live with real secrets.
# docker compose --env-file .env.live -f docker-compose.yml -f docker-compose.live.yml up --build

OPENWEATHER_API_KEY=
OPENWEATHER_QUERY=Bengaluru,IN

# Optional official warnings (leave empty → IMD NOT_CONFIGURED)
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_STATION_ID=43314

# Optional Copernicus OAuth (STAC search often works without)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1

# Optional local YOLO weights path inside the container
YOLO_WEIGHTS_PATH=

DEMO_LATITUDE=12.9716
DEMO_LONGITUDE=77.5946
AOI_NAME=Karnataka / Bengaluru (India)
VITE_API_BASE_URL=http://localhost:8000
