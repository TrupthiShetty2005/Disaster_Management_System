VITE_API_BASE_URL=http://127.0.0.1:8000
# false = Real Data Mode (default) — call backend /api/v1; never fall back to mock.ts on errors
# true  = Demo Mode only — use data/mock.ts (explicit fallback UI path)
# Pair with backend USE_MOCK_PROVIDERS=false for end-to-end REAL DATA
# Local mock JSON is used only when this is true AND the backend reports USE_MOCK_PROVIDERS=true.
# If the API is REAL DATA or unreachable, mock JSON is never used.
VITE_USE_MOCK=false
